{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Clean & Compile & Run",
      "type": "shell",
      "command": ".\\compile.bat",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Clean Only",
      "type": "shell",
      "command": ".\\compile.bat",
      "args": ["clean"],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Compile Only",
      "type": "shell",
      "command": ".\\compile.bat",
      "args": ["compile"],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
